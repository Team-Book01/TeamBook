<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teambook.panorama.domain.admin.repository.NoticeMapper">

    <!-- ══════════════ 목록 ══════════════ -->
    <resultMap id="noticeResponseMap"
               type="com.teambook.panorama.domain.admin.dto.notice.NoticeResponse">
        <constructor>
            <idArg column="notice_id"    name="noticeId"  javaType="java.lang.Long"/>
            <arg   column="user_id"      name="userId"    javaType="java.lang.Long"/>
            <arg   column="category"     name="category"
                   javaType="com.teambook.panorama.domain.admin.entity.type.NoticeCategory"/>
            <arg   column="title"        name="title"     javaType="java.lang.String"/>
            <arg   column="content"      name="content"   javaType="java.lang.String"/>
            <arg   column="is_pinned"    name="pinned"    javaType="_boolean"/>
            <arg   column="is_important" name="important" javaType="_boolean"/>
            <arg   column="status"       name="status"
                   javaType="com.teambook.panorama.domain.admin.entity.type.NoticeStatus"/>
            <arg   column="created_at"   name="createdAt" javaType="java.time.LocalDateTime"/>
            <arg   column="updated_at"   name="updatedAt" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <!-- 목록/카운트 공유 검색조건 -->
    <sql id="noticeSearchWhere">
        FROM notices n
        <where>
            <if test="status != null and status != ''">
                AND n.status = #{status}
            </if>
            <if test="category != null and category != ''">
                AND n.category = #{category}
            </if>
            <if test="searchString != null and searchString != ''">
                AND (n.title LIKE CONCAT('%', #{searchString}, '%')
                     OR n.content LIKE CONCAT('%', #{searchString}, '%'))
            </if>
        </where>
    </sql>

    <select id="selectNotices"
            parameterType="com.teambook.panorama.domain.admin.dto.notice.NoticeSearchRequest"
            resultMap="noticeResponseMap">
        <bind name="offset" value="(page - 1) * size"/>
        SELECT n.notice_id, n.user_id, n.category, n.title, n.content,
               n.is_pinned, n.is_important, n.status, n.created_at, n.updated_at
        <include refid="noticeSearchWhere"/>
        ORDER BY n.is_pinned DESC, n.is_important DESC, n.created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countNotices"
            parameterType="com.teambook.panorama.domain.admin.dto.notice.NoticeSearchRequest"
            resultType="long">
        SELECT COUNT(*)
        <include refid="noticeSearchWhere"/>
    </select>

    <!-- ══════════════ 상세 (작성자 닉네임 users 조인) ══════════════ -->
    <resultMap id="noticeDetailMap"
               type="com.teambook.panorama.domain.admin.dto.notice.NoticeDetailResponse">
        <constructor>
            <idArg column="notice_id"    name="noticeId"    javaType="java.lang.Long"/>
            <arg   column="user_id"      name="userId"      javaType="java.lang.Long"/>
            <arg   column="category"     name="category"
                   javaType="com.teambook.panorama.domain.admin.entity.type.NoticeCategory"/>
            <arg   column="title"        name="title"       javaType="java.lang.String"/>
            <arg   column="content"      name="content"     javaType="java.lang.String"/>
            <arg   column="is_pinned"    name="pinned"      javaType="_boolean"/>
            <arg   column="is_important" name="important"   javaType="_boolean"/>
            <arg   column="view_count"   name="viewCount"   javaType="java.lang.Long"/>
            <arg   column="status"       name="status"
                   javaType="com.teambook.panorama.domain.admin.entity.type.NoticeStatus"/>
            <arg   column="nickname"     name="nickname"    javaType="java.lang.String"/>
            <arg   column="created_at"   name="createdAt"   javaType="java.time.LocalDateTime"/>
            <arg   column="updated_at"   name="updatedAt"   javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="selectNoticeDetail" resultMap="noticeDetailMap">
        SELECT n.notice_id, n.user_id, n.category, n.title, n.content,
               n.is_pinned, n.is_important, n.view_count, n.status,
               u.nickname, n.created_at, n.updated_at
        FROM notices n
        LEFT JOIN users u ON u.user_id = n.user_id
        WHERE n.notice_id = #{noticeId}
    </select>

</mapper>
