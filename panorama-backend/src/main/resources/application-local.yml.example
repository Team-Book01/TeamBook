# 로컬 개발용 설정 템플릿
# 이 파일을 복사해 같은 폴더에 application-local.yml 로 만들고 값을 채우세요.
#   (application-local.yml 은 .gitignore 처리되어 커밋되지 않습니다)
#
# 기본 프로필이 local 이므로 별도 옵션 없이 앱을 실행하면 자동으로 로드됩니다.
# 여기 값은 application.yml 의 동일 키를 덮어씁니다. 값은 ${} 없이 직접 적습니다.
spring:
  datasource:
    # DB 이름은 팀 컨벤션(panorama)에 맞춰 각자 로컬에 생성 후 사용하세요.
    url: jdbc:mysql://localhost:3306/panorama?serverTimezone=Asia/Seoul
    username: your_local_db_username
    password: your_local_db_password
  jpa:
    show-sql: true
